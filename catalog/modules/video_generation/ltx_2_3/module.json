  "interface": {
    "inputs": [
      {
        "name": "first_frame",
        "type": "IMAGE",
        "required": false,
        "description": "Imagen inicial para animación I2V. Si se omite o desconecta, genera en modo Text-to-Video."
      },
      {
        "name": "prompt",
        "type": "STRING",
        "required": true,
        "description": "Prompt multimodal que describe acciones continuas en el tiempo, detalles visuales y sonido/diálogos requeridos."
      },
      {
        "name": "prompt_enhance",
        "type": "BOOLEAN",
        "default": false,
        "description": "Activa el nodo LLM 'TextGenerateLTX2Prompt' para enriquecer el prompt automáticamente antes de enviarlo al modelo de difusión."
      },
      {
        "name": "width",
        "type": "INT",
        "default": 1280,
        "constraint": "Múltiplos de 32 (resoluciones típicas: 1280, 1920, 768)"
      },
      {
        "name": "height",
        "type": "INT",
        "default": 720,
        "constraint": "Múltiplos de 32 (resoluciones típicas: 720, 1080, 768)"
      },
      {
        "name": "duration",
        "type": "INT",
        "default": 5,
        "description": "Duración en segundos del video"
      },
      {
        "name": "fps",
        "type": "INT",
        "default": 25,
        "description": "Fotogramas por segundo del video resultante"
      },
      {
        "name": "seed",
        "type": "INT",
        "default": 60540193790228
      }
    ],
    "outputs": [
      {
        "name": "video",
        "type": "VIDEO",
        "description": "Contenedor de video (MP4) con audio estéreo sincronizado nativo"
      }
    ]
  },
