    "subgraph_type": "4c314f31-ecda-4b08-ae98-faaba1bf613f",
    "subgraph_name": "Image to Video (MiniMax H3)",
    "core_nodes_used": [
      "MiniMaxH3ImageToVideo",
      "UNETLoader",
      "CLIPLoader",
      "VAELoader",
      "VAEDecode",
      "VAEDecodeAudio",
      "CreateVideo",
      "BasicGuider",
      "BasicScheduler",
      "KSamplerSelect",
      "SamplerCustomAdvanced",
      "LoraLoaderModelOnly",
      "ResolutionSelector",
      "SaveVideo"
    ]
  },
  "interface": {
    "inputs": [
      {
        "name": "first_frame",
        "type": "IMAGE",
        "required": false,
        "description": "Primer fotograma para Image-to-Video. Si no se conecta, opera como Text-to-Video."
      },
      {
        "name": "last_frame",
        "type": "IMAGE",
        "required": false,
        "description": "Último fotograma opcional para animación interpolada de inicio a fin."
      },
      {
        "name": "prompt",
        "type": "STRING",
        "description": "Descripción de escenas, movimiento de cámara y audio (SFX/música). Admite tokens 'embedding:<nombre>'."
      },
      {
        "name": "width",
        "type": "INT",
        "default": 1344,
        "constraint": "Múltiplo de 32, eje corto máx 768px"
      },
      {
        "name": "height",
        "type": "INT",
        "default": 768,
        "constraint": "Múltiplo de 32, eje corto máx 768px"
      },
      {
        "name": "duration",
        "type": "FLOAT",
        "default": 5.0,
        "description": "Segundos de video (ajusta automáticamente a bloques de 17 frames a 24fps)"
      },
      {
        "name": "turbo_mode",
        "type": "BOOLEAN",
        "default": false,
        "description": "Activa inferencia rápida con Turbo LoRA (4 u 8 pasos)"
      },
      {
        "name": "turbo_steps",
        "type": "INT",
        "default": 8,
        "options": [4, 8]
      }
    ],
    "outputs": [
      {
        "name": "video",
        "type": "VIDEO",
        "description": "Contenedor de video completo con pista de audio multiplexada nativa"
      }
    ]
  },
