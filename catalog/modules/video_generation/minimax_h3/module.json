{
  "id": "minimax_h3",
  "name": "MiniMax H3 Video & Audio Generation",
  "category": "video_generation",
  "description": "Modelo omnimodal para generación de video de hasta 2K a 24fps con audio estéreo nativo integrado (diálogos, SFX, música en un solo pase). Soporta T2V, I2V y FL2V con aceleración Turbo LoRA.",
  "comfy_min_version": "0.33.0",
